# Single source of truth for the patched Harbor registry image. build.sh reads
# this file, validates every value, and passes them to the Dockerfile as build
# args; the Dockerfile has no defaults. Every value below was read off the live
# deployment or the base image on 2026-10-04 -- see README.md "Pins".

# Where the image is published, and the Harbor release it patches.
IMAGE_REPO=ghcr.io/blockcast/harbor-registry-photon
HARBOR_VERSION=v2.14.0

# goharbor/registry-photon:v2.14.0 exactly as the live harbor-registry
# Deployment runs it (container "registry"). Single-arch linux/amd64 manifest,
# not an index, which is why PLATFORM below is fixed.
BASE_IMAGE=docker.io/goharbor/registry-photon@sha256:b20f12d92b0f5126dc1e5d5f9f861f54d023e18f2a759d5a027b3efcc401e6d1
PLATFORM=linux/amd64

# goharbor/distribution revision the base image's /usr/bin/registry_DO_NOT_USE_GC
# was built from (its build info: -X version.Revision=<this>), and the
# `git describe` string that binary reports from --version.
DISTRIBUTION_REPO=https://github.com/goharbor/distribution.git
DISTRIBUTION_SHA=0c62ec3ec8df7ea91c819448236a67f0777f929f
DISTRIBUTION_DESCRIBE=v2.8.3-23-g0c62ec3e

# The base binary's toolchain (`go version -m`: go1.24.6), which is also
# Harbor v2.14.0's Makefile GOBUILDIMAGE=golang:1.24.6. Pinned by index digest.
GOLANG_IMAGE=docker.io/library/golang:1.24.6@sha256:8d9e57c5a6f2bede16fe674c16149eee20db6907129e02c4ad91ce5a697a4012

# Patch identity. Image tag    = ${HARBOR_VERSION}-${PATCH_ID}.${PATCH_REVISION}
#                 Binary version = ${DISTRIBUTION_DESCRIBE}+blockcast-${PATCH_ID}.${PATCH_REVISION}
# Bump PATCH_REVISION whenever anything in this directory changes: build.sh
# refuses to repoint an already-published tag.
PATCH_ID=taglookup
PATCH_REVISION=1
