# Single source of truth for the patched Harbor registry image. build.sh reads
# this file, validates every value, and passes them to the Dockerfile as build
# args; the Dockerfile has no defaults. Every value below was read off the released
# v2.15.4 base image on 2026-10-12 -- see README.md "Pins".

# Where the image is published, and the Harbor release it patches.
IMAGE_REPO=ghcr.io/blockcast/harbor-registry-photon
HARBOR_VERSION=v2.15.4

# goharbor/registry-photon:v2.15.4 from Docker Hub. Single-arch linux/amd64 manifest,
# not an index, which is why PLATFORM below is fixed.
BASE_IMAGE=docker.io/goharbor/registry-photon@sha256:dc0cb388a6445c69c8a0c406679290d2991c9698833d9e6e86a23bdfaf2f83c3
PLATFORM=linux/amd64

# goharbor/distribution revision the base image's /usr/bin/registry_DO_NOT_USE_GC
# was built from (its build info: -X version.Revision=<this>), and the
# `git describe` string that binary reports from --version.
DISTRIBUTION_REPO=https://github.com/goharbor/distribution.git
DISTRIBUTION_SHA=ac7c4cedc2f4d45347630beceaaa1639bb9c771a
DISTRIBUTION_DESCRIBE=v2.8.3-55-gac7c4ced

# The base binary's toolchain (`go version -m`: go1.26.7), which is also
# Harbor v2.15.4's Makefile GOBUILDIMAGE=golang:1.26.7. Pinned by index digest.
GOLANG_IMAGE=docker.io/library/golang:1.26.7@sha256:e30143be198ab04cf7ba25fba83ab3a692ca584c994aad0bf131fa0eb32dd8c1

# Patch identity. Image tag    = ${HARBOR_VERSION}-${PATCH_ID}.${PATCH_REVISION}
#                 Binary version = ${DISTRIBUTION_DESCRIBE}+blockcast-${PATCH_ID}.${PATCH_REVISION}
# Bump PATCH_REVISION whenever anything in this directory changes: build.sh
# refuses to repoint an already-published tag.
PATCH_ID=taglookup
PATCH_REVISION=4
