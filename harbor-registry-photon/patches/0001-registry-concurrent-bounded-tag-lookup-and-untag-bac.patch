diff --git a/registry/storage/tagstore_concurrency_test.go b/registry/storage/tagstore_concurrency_test.go
new file mode 100644
index 0000000..d64ee08
--- /dev/null
+++ b/registry/storage/tagstore_concurrency_test.go
@@ -0,0 +1,404 @@
+package storage
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/distribution/reference"
+	"github.com/docker/distribution"
+	storagedriver "github.com/docker/distribution/registry/storage/driver"
+	"github.com/docker/distribution/registry/storage/driver/inmemory"
+	"github.com/opencontainers/go-digest"
+)
+
+// Tests for the backport of distribution/distribution a2afe23f38 ("add
+// concurrency limits for tag lookup and untag") onto goharbor/distribution
+// release/2.8.
+
+const currentLinkSuffix = "/current/link"
+
+// serialLookup is the pre-backport tagStore.Lookup algorithm, kept verbatim
+// (modulo receiver) as the reference the concurrent implementation must match.
+func serialLookup(ctx context.Context, ts *tagStore, desc distribution.Descriptor) ([]string, error) {
+	allTags, err := ts.All(ctx)
+	switch err.(type) {
+	case distribution.ErrRepositoryUnknown:
+		break
+	case nil:
+		break
+	default:
+		return nil, err
+	}
+
+	var tags []string
+	for _, tag := range allTags {
+		tagLinkPathSpec := manifestTagCurrentPathSpec{
+			name: ts.repository.Named().Name(),
+			tag:  tag,
+		}
+
+		tagLinkPath, _ := pathFor(tagLinkPathSpec)
+		tagDigest, err := ts.blobStore.readlink(ctx, tagLinkPath)
+		if err != nil {
+			switch err.(type) {
+			case storagedriver.PathNotFoundError:
+				continue
+			}
+			return nil, err
+		}
+
+		if tagDigest == desc.Digest {
+			tags = append(tags, tag)
+		}
+	}
+
+	return tags, nil
+}
+
+func newTestTagStore(t *testing.T, d storagedriver.StorageDriver, options ...RegistryOption) (context.Context, *tagStore) {
+	t.Helper()
+	ctx := context.Background()
+	reg, err := NewRegistry(ctx, d, options...)
+	if err != nil {
+		t.Fatal(err)
+	}
+	repoRef, _ := reference.WithName("a/b")
+	repo, err := reg.Repository(ctx, repoRef)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ts, ok := repo.Tags(ctx).(*tagStore)
+	if !ok {
+		t.Fatalf("repo.Tags returned %T, want *tagStore", repo.Tags(ctx))
+	}
+	return ctx, ts
+}
+
+func digestFor(i int) digest.Digest {
+	return digest.FromString(fmt.Sprintf("manifest-%d", i))
+}
+
+func sortedCopy(in []string) []string {
+	out := append([]string(nil), in...)
+	sort.Strings(out)
+	return out
+}
+
+// TestTagLookupMatchesSerial populates a repository with many tags spread
+// across several digests, removes the current/link of a subset of them (a tag
+// directory that All() lists but whose link is missing must be skipped, not
+// fail the lookup), and checks the concurrent Lookup returns exactly the tag
+// set the serial algorithm returns for every digest.
+func TestTagLookupMatchesSerial(t *testing.T) {
+	d := inmemory.New()
+	ctx, ts := newTestTagStore(t, d)
+
+	// Enough tags that every worker slot is reused many times over.
+	numTags := ts.concurrencyLimit * 16
+	numDigests := 7
+	missingEvery := 5
+
+	missing := map[string]bool{}
+	for i := 0; i < numTags; i++ {
+		tag := fmt.Sprintf("tag-%04d", i)
+		if err := ts.Tag(ctx, tag, distribution.Descriptor{Digest: digestFor(i % numDigests)}); err != nil {
+			t.Fatal(err)
+		}
+		if i%missingEvery == 0 {
+			p, err := pathFor(manifestTagCurrentPathSpec{name: ts.repository.Named().Name(), tag: tag})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := d.Delete(ctx, p); err != nil {
+				t.Fatal(err)
+			}
+			missing[tag] = true
+		}
+	}
+
+	all, err := ts.All(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(all) != numTags {
+		t.Fatalf("All returned %d tags, want %d (missing-link tags must still be listed)", len(all), numTags)
+	}
+
+	total := 0
+	// One extra digest that no tag references.
+	for i := 0; i <= numDigests; i++ {
+		desc := distribution.Descriptor{Digest: digestFor(i)}
+		want, err := serialLookup(ctx, ts, desc)
+		if err != nil {
+			t.Fatal(err)
+		}
+		got, err := ts.Lookup(ctx, desc)
+		if err != nil {
+			t.Fatal(err)
+		}
+		w, g := sortedCopy(want), sortedCopy(got)
+		if strings.Join(w, ",") != strings.Join(g, ",") {
+			t.Fatalf("digest %d: concurrent Lookup = %v, serial = %v", i, g, w)
+		}
+		for _, tag := range got {
+			if missing[tag] {
+				t.Fatalf("Lookup returned tag %q whose current link was removed", tag)
+			}
+		}
+		total += len(got)
+	}
+	if want := numTags - len(missing); total != want {
+		t.Fatalf("Lookup across all digests returned %d tags, want %d", total, want)
+	}
+}
+
+// TestTagLookupEmptyRepository preserves the pre-backport behaviour that an
+// initialised but unpopulated tag store yields no tags and no error.
+func TestTagLookupEmptyRepository(t *testing.T) {
+	ctx, ts := newTestTagStore(t, inmemory.New())
+	tags, err := ts.Lookup(ctx, distribution.Descriptor{Digest: digestFor(0)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(tags) != 0 {
+		t.Fatalf("Lookup on empty repository returned %v", tags)
+	}
+}
+
+// gatedDriver counts concurrent current-link reads and can fail one of them.
+type gatedDriver struct {
+	storagedriver.StorageDriver
+
+	mu       sync.Mutex
+	inFlight int
+	maxSeen  int
+
+	// release is closed once inFlight first reaches gate; reads block on it
+	// so the test can prove gate reads really were in flight together.
+	gate    int
+	release chan struct{}
+
+	failPath string
+	failErr  error
+}
+
+func (g *gatedDriver) GetContent(ctx context.Context, path string) ([]byte, error) {
+	if !strings.HasSuffix(path, currentLinkSuffix) {
+		return g.StorageDriver.GetContent(ctx, path)
+	}
+	if path == g.failPath {
+		return nil, g.failErr
+	}
+
+	g.mu.Lock()
+	g.inFlight++
+	if g.inFlight > g.maxSeen {
+		g.maxSeen = g.inFlight
+	}
+	if g.release != nil && g.inFlight == g.gate {
+		close(g.release)
+		g.release = nil
+	}
+	ch := g.release
+	g.mu.Unlock()
+
+	if ch != nil {
+		select {
+		case <-ch:
+		case <-ctx.Done():
+		}
+	}
+
+	defer func() {
+		g.mu.Lock()
+		g.inFlight--
+		g.mu.Unlock()
+	}()
+	return g.StorageDriver.GetContent(ctx, path)
+}
+
+// TestTagLookupConcurrencyIsBounded proves Lookup issues exactly up to the
+// configured number of link reads at once: every read blocks until `limit`
+// reads are in flight together (so a serial implementation would never make
+// progress), and the observed maximum never exceeds the limit.
+func TestTagLookupConcurrencyIsBounded(t *testing.T) {
+	limit := 4
+	gd := &gatedDriver{StorageDriver: inmemory.New(), gate: limit, release: make(chan struct{})}
+	ctx, ts := newTestTagStore(t, gd, TagLookupConcurrencyLimit(limit))
+	if ts.concurrencyLimit != limit {
+		t.Fatalf("tagStore.concurrencyLimit = %d, want %d", ts.concurrencyLimit, limit)
+	}
+
+	numTags := limit * 8
+	for i := 0; i < numTags; i++ {
+		if err := ts.Tag(ctx, fmt.Sprintf("t%d", i), distribution.Descriptor{Digest: digestFor(0)}); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	done := make(chan struct{})
+	var (
+		tags []string
+		err  error
+	)
+	go func() {
+		defer close(done)
+		tags, err = ts.Lookup(ctx, distribution.Descriptor{Digest: digestFor(0)})
+	}()
+
+	deadline, ok := t.Deadline()
+	if !ok {
+		<-done
+	} else {
+		lctx, cancel := context.WithDeadline(context.Background(), deadline)
+		defer cancel()
+		select {
+		case <-done:
+		case <-lctx.Done():
+			t.Fatalf("Lookup never reached %d concurrent link reads (max seen %d)", limit, gd.maxSeen)
+		}
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(tags) != numTags {
+		t.Fatalf("Lookup returned %d tags, want %d", len(tags), numTags)
+	}
+	gd.mu.Lock()
+	defer gd.mu.Unlock()
+	if gd.maxSeen != limit {
+		t.Fatalf("max concurrent link reads = %d, want exactly %d", gd.maxSeen, limit)
+	}
+}
+
+// TestTagLookupPropagatesStorageError keeps the fail-closed behaviour: a
+// storage error other than PathNotFound on any tag fails the whole lookup
+// instead of silently returning a partial tag set.
+func TestTagLookupPropagatesStorageError(t *testing.T) {
+	gd := &gatedDriver{StorageDriver: inmemory.New()}
+	ctx, ts := newTestTagStore(t, gd)
+
+	numTags := ts.concurrencyLimit * 4
+	for i := 0; i < numTags; i++ {
+		if err := ts.Tag(ctx, fmt.Sprintf("t%d", i), distribution.Descriptor{Digest: digestFor(0)}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	failPath, err := pathFor(manifestTagCurrentPathSpec{name: ts.repository.Named().Name(), tag: fmt.Sprintf("t%d", numTags/2)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	gd.failPath = failPath
+	gd.failErr = errors.New("injected backend failure")
+
+	tags, err := ts.Lookup(ctx, distribution.Descriptor{Digest: digestFor(0)})
+	if err == nil {
+		t.Fatalf("Lookup succeeded with %d tags despite a backend read failure", len(tags))
+	}
+	if !errors.Is(err, gd.failErr) {
+		t.Fatalf("Lookup error = %v, want %v", err, gd.failErr)
+	}
+	if tags != nil {
+		t.Fatalf("Lookup returned partial tags %v alongside an error", tags)
+	}
+}
+
+// TestTagLookupConcurrencyLimitOption checks the RegistryOption plumbing and
+// that an unset or zero limit falls back to GOMAXPROCS, as upstream does.
+func TestTagLookupConcurrencyLimitOption(t *testing.T) {
+	cases := []struct {
+		name    string
+		options []RegistryOption
+		want    int
+	}{
+		{name: "unset", want: DefaultConcurrencyLimit},
+		{name: "zero", options: []RegistryOption{TagLookupConcurrencyLimit(0)}, want: DefaultConcurrencyLimit},
+		{name: "explicit", options: []RegistryOption{TagLookupConcurrencyLimit(DefaultConcurrencyLimit + 1)}, want: DefaultConcurrencyLimit + 1},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			_, ts := newTestTagStore(t, inmemory.New(), tc.options...)
+			if ts.concurrencyLimit != tc.want {
+				t.Fatalf("concurrencyLimit = %d, want %d", ts.concurrencyLimit, tc.want)
+			}
+		})
+	}
+}
+
+// cancelOnReadDriver cancels a context the first time a current link is read,
+// then completes that read (and every later one) successfully, ignoring the
+// context the way a backend call that already finished would.
+type cancelOnReadDriver struct {
+	storagedriver.StorageDriver
+
+	once   sync.Once
+	cancel context.CancelFunc
+}
+
+func (c *cancelOnReadDriver) GetContent(ctx context.Context, path string) ([]byte, error) {
+	if strings.HasSuffix(path, currentLinkSuffix) && c.cancel != nil {
+		c.once.Do(c.cancel)
+	}
+	return c.StorageDriver.GetContent(ctx, path)
+}
+
+// TestTagLookupCancelledContextFails: a lookup whose context is cancelled
+// before it has read every tag link must fail, never return the tags it read
+// so far with a nil error. DeleteManifest untags exactly what Lookup returns
+// and then answers 202, so a short list with no error leaves tags pointing at
+// the deleted manifest. (Upstream a2afe23f38 has this bug: its loop stops
+// launching reads once ctx is done and g.Wait() returns nil.)
+func TestTagLookupCancelledContextFails(t *testing.T) {
+	populate := func(t *testing.T, d storagedriver.StorageDriver) (*tagStore, int) {
+		t.Helper()
+		_, ts := newTestTagStore(t, d)
+		// More tags than worker slots, so tags remain unread after the
+		// cancellation regardless of scheduling.
+		numTags := ts.concurrencyLimit*4 + 2
+		for i := 0; i < numTags; i++ {
+			if err := ts.Tag(context.Background(), fmt.Sprintf("t%d", i), distribution.Descriptor{Digest: digestFor(0)}); err != nil {
+				t.Fatal(err)
+			}
+		}
+		return ts, numTags
+	}
+
+	t.Run("cancelled before lookup", func(t *testing.T) {
+		ts, numTags := populate(t, inmemory.New())
+		ctx, cancel := context.WithCancel(context.Background())
+		cancel()
+		tags, err := ts.Lookup(ctx, distribution.Descriptor{Digest: digestFor(0)})
+		if err == nil {
+			t.Fatalf("Lookup with a cancelled context returned %d of %d tags and no error", len(tags), numTags)
+		}
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("Lookup error = %v, want context.Canceled", err)
+		}
+		if tags != nil {
+			t.Fatalf("Lookup returned partial tags %v alongside an error", tags)
+		}
+	})
+
+	t.Run("cancelled during lookup", func(t *testing.T) {
+		cd := &cancelOnReadDriver{StorageDriver: inmemory.New()}
+		ts, numTags := populate(t, cd)
+		ctx, cancel := context.WithCancel(context.Background())
+		defer cancel()
+		cd.cancel = cancel
+		tags, err := ts.Lookup(ctx, distribution.Descriptor{Digest: digestFor(0)})
+		if err == nil {
+			t.Fatalf("Lookup cancelled mid-flight returned %d of %d tags and no error", len(tags), numTags)
+		}
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("Lookup error = %v, want context.Canceled", err)
+		}
+		if tags != nil {
+			t.Fatalf("Lookup returned partial tags %v alongside an error", tags)
+		}
+	})
+}
