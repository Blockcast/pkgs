@@ -513,18 +517,49 @@ func (imh *manifestHandler) DeleteManifest(w http.ResponseWriter, r *http.Reques
 		}
 	}
 
-	tagService := imh.Repository.Tags(imh)
-	referencedTags, err := tagService.Lookup(imh, distribution.Descriptor{Digest: imh.Digest})
+	// Blockcast deviation from upstream a2afe23f38: the manifest is gone, so
+	// finish removing the tags that reference it even if the request is
+	// cancelled (client disconnect, caller timeout). Failing here instead
+	// leaves those tags pointing at the deleted manifest, and nobody sees the
+	// error: the client has gone, and a retried DELETE gets 404 (Harbor GC
+	// counts that as success). This is also what the code it replaces does on
+	// S3 in practice, because the s3-aws driver ignores the request context.
+	cleanupCtx := context.WithoutCancel(imh)
+	tagService := imh.Repository.Tags(cleanupCtx)
+	referencedTags, err := tagService.Lookup(cleanupCtx, distribution.Descriptor{Digest: imh.Digest})
 	if err != nil {
 		imh.Errors = append(imh.Errors, err)
 		return
 	}
 
+	var (
+		errs []error
+		mu   sync.Mutex
+	)
+	g := errgroup.Group{}
+	g.SetLimit(storage.DefaultConcurrencyLimit)
 	for _, tag := range referencedTags {
-		if err := tagService.Untag(imh, tag); err != nil {
-			imh.Errors = append(imh.Errors, err)
-			return
-		}
+		tag := tag
+
+		g.Go(func() error {
+			if err := tagService.Untag(cleanupCtx, tag); err != nil {
+				mu.Lock()
+				errs = append(errs, err)
+				mu.Unlock()
+			}
+			return nil
+		})
+	}
+	_ = g.Wait() // imh will record all errors, so ignore the error of Wait()
+
+	// Blockcast deviation from upstream a2afe23f38: upstream assigns
+	// imh.Errors = errs and then unconditionally writes 202 Accepted, which
+	// reports success for a DELETE that left dangling tags. The serial code
+	// this replaces returned the error without writing 202; keep that
+	// fail-closed behaviour.
+	if len(errs) > 0 {
+		imh.Errors = append(imh.Errors, errs...)
+		return
 	}
 
 	w.WriteHeader(http.StatusAccepted)
