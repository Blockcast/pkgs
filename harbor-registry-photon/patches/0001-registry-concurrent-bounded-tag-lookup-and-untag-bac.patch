+package handlers
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"regexp"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/distribution/reference"
+	"github.com/docker/distribution"
+	"github.com/docker/distribution/configuration"
+	"github.com/docker/distribution/registry/storage"
+	storagedriver "github.com/docker/distribution/registry/storage/driver"
+	"github.com/docker/distribution/registry/storage/driver/factory"
+	"github.com/docker/distribution/registry/storage/driver/inmemory"
+	"github.com/opencontainers/go-digest"
+)
+
+// Tests for the backport of distribution/distribution a2afe23f38 ("add
+// concurrency limits for tag lookup and untag") onto goharbor/distribution
+// release/2.8.
+
+const (
+	untagFailDriverName      = "untagfaildriver"
+	cancelOnLookupDriverName = "cancelonlookupdriver"
+)
+
+// tagDirPath matches the manifestTagPathSpec directory that tagStore.Untag
+// deletes: <root>/v2/repositories/<name>/_manifests/tags/<tag>
+var tagDirPath = regexp.MustCompile(`/_manifests/tags/[^/]+$`)
+
+var errInjectedUntag = errors.New("injected untag failure")
+
+func init() {
+	factory.Register(untagFailDriverName, &untagFailDriverFactory{})
+	factory.Register(cancelOnLookupDriverName, &cancelOnLookupDriverFactory{})
+}
+
+type untagFailDriverFactory struct{}
+
+func (f *untagFailDriverFactory) Create(parameters map[string]interface{}) (storagedriver.StorageDriver, error) {
+	return &untagFailDriver{StorageDriver: inmemory.New()}, nil
+}
+
+// untagFailDriver fails every tag-directory delete, i.e. every Untag.
+type untagFailDriver struct {
+	storagedriver.StorageDriver
+}
+
+func (d *untagFailDriver) Delete(ctx context.Context, path string) error {
+	if tagDirPath.MatchString(path) {
+		return errInjectedUntag
+	}
+	return d.StorageDriver.Delete(ctx, path)
+}
+
+func tagConcurrencyTestConfig(driver string, tag configuration.Parameters) *configuration.Configuration {
+	config := &configuration.Configuration{
+		Storage: configuration.Storage{
+			driver:   configuration.Parameters{},
+			"delete": configuration.Parameters{"enabled": true},
+			"maintenance": configuration.Parameters{"uploadpurging": map[interface{}]interface{}{
+				"enabled": false,
+			}},
+		},
+	}
+	if tag != nil {
+		config.Storage["tag"] = tag
+	}
+	config.Compatibility.Schema1.Enabled = true
+	config.HTTP.Headers = headerConfig
+	return config
+}
+
+func TestNewAppTagConcurrencyLimitConfig(t *testing.T) {
+	cases := []struct {
+		name      string
+		tag       configuration.Parameters
+		wantPanic string
+	}{
+		{name: "absent"},
+		{name: "zero", tag: configuration.Parameters{"concurrencylimit": 0}},
+		{name: "positive", tag: configuration.Parameters{"concurrencylimit": 8}},
+		{name: "string", tag: configuration.Parameters{"concurrencylimit": "8"}, wantPanic: "must have a integer value"},
+		{name: "negative", tag: configuration.Parameters{"concurrencylimit": -1}, wantPanic: "non-negative integer value"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			defer func() {
+				r := recover()
+				if tc.wantPanic == "" {
+					if r != nil {
+						t.Fatalf("NewApp panicked: %v", r)
+					}
+					return
+				}
+				if r == nil {
+					t.Fatalf("NewApp accepted invalid tag config %v", tc.tag)
+				}
+				if !strings.Contains(fmt.Sprint(r), tc.wantPanic) {
+					t.Fatalf("panic = %v, want it to contain %q", r, tc.wantPanic)
+				}
+			}()
+			NewApp(context.Background(), tagConcurrencyTestConfig("testdriver", tc.tag))
+		})
+	}
+}
+
+func deleteByDigest(t *testing.T, env *testEnv, imageName string, dgst digest.Digest) *http.Response {
+	t.Helper()
+	named, err := reference.WithName(imageName)
+	if err != nil {
+		t.Fatal(err)
+	}
+	digestRef, err := reference.WithDigest(named, dgst)
+	if err != nil {
+		t.Fatal(err)
+	}
+	u, err := env.builder.BuildManifestURL(digestRef)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp, err := httpDelete(u)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return resp
+}
+
+// TestDeleteManifestUntagsAllReferencingTags is the positive control: a
+// manifest referenced by many tags is deleted with 202 and every tag that
+// referenced it is removed by the concurrent untag loop.
+func TestDeleteManifestUntagsAllReferencingTags(t *testing.T) {
+	env := newTestEnvWithConfig(t, tagConcurrencyTestConfig("testdriver", nil))
+	defer env.Shutdown()
+
+	imageName := "foo/concurrent-untag"
+	dgst := createRepository(env, t, imageName, "latest")
+
+	named, _ := reference.WithName(imageName)
+	repo, err := env.app.registry.Repository(env.ctx, named)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tags := repo.Tags(env.ctx)
+	// Several times the untag worker limit so worker slots are reused.
+	extra := 4 * storage.DefaultConcurrencyLimit
+	for i := 0; i < extra; i++ {
+		if err := tags.Tag(env.ctx, fmt.Sprintf("extra-%d", i), distribution.Descriptor{Digest: dgst}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	before, err := tags.Lookup(env.ctx, distribution.Descriptor{Digest: dgst})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(before) != extra+1 {
+		t.Fatalf("Lookup before delete = %d tags, want %d", len(before), extra+1)
+	}
+
+	resp := deleteByDigest(t, env, imageName, dgst)
+	defer resp.Body.Close()
+	checkResponse(t, "deleting manifest", resp, http.StatusAccepted)
+
+	after, err := tags.Lookup(env.ctx, distribution.Descriptor{Digest: dgst})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(after) != 0 {
+		t.Fatalf("tags still reference deleted manifest: %v", after)
+	}
+}
+
+// TestDeleteManifestUntagFailureFailsClosed checks the Blockcast deviation
+// from upstream: if any Untag fails the DELETE must not report 202 Accepted.
+func TestDeleteManifestUntagFailureFailsClosed(t *testing.T) {
+	env := newTestEnvWithConfig(t, tagConcurrencyTestConfig(untagFailDriverName, nil))
+	defer env.Shutdown()
+
+	imageName := "foo/untag-fails"
+	dgst := createRepository(env, t, imageName, "latest")
+
+	resp := deleteByDigest(t, env, imageName, dgst)
+	defer resp.Body.Close()
+	if resp.StatusCode == http.StatusAccepted {
+		t.Fatalf("DELETE returned 202 Accepted although every Untag failed")
+	}
+	checkResponse(t, "deleting manifest with failing untag", resp, http.StatusInternalServerError)
+}
+
+// cancelOnLookupDriver calls the armed cancel func the first time a tag's
+// current link is read (that is, inside tagStore.Lookup) and still completes
+// the read, so the cancellation lands in the middle of the lookup.
+type cancelOnLookupDriver struct {
+	storagedriver.StorageDriver
+
+	mu     sync.Mutex
+	cancel context.CancelFunc
+}
+
+type cancelOnLookupDriverFactory struct{}
+
+var (
+	cancelOnLookupDriversMu sync.Mutex
+	cancelOnLookupDrivers   []*cancelOnLookupDriver
+)
+
+func (f *cancelOnLookupDriverFactory) Create(parameters map[string]interface{}) (storagedriver.StorageDriver, error) {
+	d := &cancelOnLookupDriver{StorageDriver: inmemory.New()}
+	cancelOnLookupDriversMu.Lock()
+	cancelOnLookupDrivers = append(cancelOnLookupDrivers, d)
+	cancelOnLookupDriversMu.Unlock()
+	return d, nil
+}
+
+func (d *cancelOnLookupDriver) arm(cancel context.CancelFunc) {
+	d.mu.Lock()
+	d.cancel = cancel
+	d.mu.Unlock()
+}
+
+func (d *cancelOnLookupDriver) GetContent(ctx context.Context, path string) ([]byte, error) {
+	if strings.HasSuffix(path, "/current/link") {
+		d.mu.Lock()
+		cancel := d.cancel
+		d.cancel = nil
+		d.mu.Unlock()
+		if cancel != nil {
+			cancel()
+		}
+	}
+	return d.StorageDriver.GetContent(ctx, path)
+}
+
+// TestDeleteManifestCancelledRequestUntagsAll: a DELETE whose request context
+// is cancelled while DeleteManifest is looking up the referencing tags (client
+// disconnect, caller timeout) must still untag every tag that referenced the
+// manifest, because the manifest is already deleted by then. Upstream
+// a2afe23f38's Lookup returns the tags read so far with a nil error in that
+// case, so the handler untags only some of them; a Lookup that fails on the
+// cancelled context instead untags none. Either way tags are left pointing at
+// the deleted manifest, and nobody sees the error: the client has gone, and
+// Harbor GC's retry of the DELETE gets 404, which it treats as success.
+func TestDeleteManifestCancelledRequestUntagsAll(t *testing.T) {
+	cancelOnLookupDriversMu.Lock()
+	cancelOnLookupDrivers = nil
+	cancelOnLookupDriversMu.Unlock()
+
+	env := newTestEnvWithConfig(t, tagConcurrencyTestConfig(cancelOnLookupDriverName, nil))
+	defer env.Shutdown()
+
+	cancelOnLookupDriversMu.Lock()
+	drivers := append([]*cancelOnLookupDriver(nil), cancelOnLookupDrivers...)
+	cancelOnLookupDriversMu.Unlock()
+	if len(drivers) != 1 {
+		t.Fatalf("expected the app to create exactly one %s driver, got %d", cancelOnLookupDriverName, len(drivers))
+	}
+	driver := drivers[0]
+
+	imageName := "foo/cancelled-delete"
+	dgst := createRepository(env, t, imageName, "latest")
+
+	named, _ := reference.WithName(imageName)
+	repo, err := env.app.registry.Repository(env.ctx, named)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tags := repo.Tags(env.ctx)
+	// More referencing tags than lookup worker slots, so some remain unread
+	// when the cancellation lands, whatever the scheduling.
+	extra := 4*storage.DefaultConcurrencyLimit + 1
+	for i := 0; i < extra; i++ {
+		if err := tags.Tag(env.ctx, fmt.Sprintf("extra-%d", i), distribution.Descriptor{Digest: dgst}); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	digestRef, err := reference.WithDigest(named, dgst)
+	if err != nil {
+		t.Fatal(err)
+	}
+	u, err := env.builder.BuildManifestURL(digestRef)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	req := httptest.NewRequest(http.MethodDelete, u, nil).WithContext(ctx)
+	rec := httptest.NewRecorder()
+
+	driver.arm(cancel)
+	env.app.ServeHTTP(rec, req)
+
+	if ctx.Err() == nil {
+		t.Fatalf("the lookup never read a tag link, so the cancellation was not exercised")
+	}
+	remaining, err := tags.Lookup(env.ctx, distribution.Descriptor{Digest: dgst})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(remaining) != 0 {
+		t.Fatalf("DELETE cancelled during tag lookup returned %d; %d of %d tag(s) still reference the deleted manifest", rec.Code, len(remaining), extra+1)
+	}
+	if rec.Code != http.StatusAccepted {
+		t.Fatalf("DELETE cancelled during tag lookup untagged everything but returned %d, want %d", rec.Code, http.StatusAccepted)
+	}
+}
